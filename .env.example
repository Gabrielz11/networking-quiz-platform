# -----------------------------------------------------------------------------
# Lumina LMS - Exemplo de Configuração de Ambiente (.env.example)
# Copie este arquivo para ".env" e preencha com as suas credenciais.
# -----------------------------------------------------------------------------

# 1. Banco de Dados PostgreSQL (Local ou via Docker)
# Configuração de credenciais usadas no docker-compose.yml e na conexão do Prisma
DB_USER="admin"
DB_PASSWORD="password123"
DB_NAME="lumina_lms"
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public"

# 2. Autenticação e URLs do NextAuth
# NEXTAUTH_SECRET: Chave randômica para encriptação de tokens (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="seu_segredo_do_nextauth_aqui"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Chave de Registro de Professores
# Código de validação exigido no cadastro de novos usuários com nível de acesso TEACHER
TEACHER_REGISTRATION_KEY="sua_chave_de_cadastro_de_professor_aqui"

# 4. Mensageria e Filas Assíncronas (BullMQ + Redis)
# Porta padrão utilizada no container do Redis (lumina_redis)
REDIS_URL="redis://localhost:6379"

# 5. Provedores de Inteligência Artificial
# Google Gemini (Usado para geração de explicações e quizzes leves)
GEMINI_API_KEY="sua_chave_gemini_api_aqui"
GEMINI_MODEL="gemini-2.5-flash"

# Groq Cloud (Usado como redundância / Fallback em caso de falha do Gemini)
GROQ_API_KEY="sua_chave_groq_api_aqui"

# OpenAI (Usado para geração de embeddings semânticos vetoriais do RAG)
OPENAI_API_KEY="sua_chave_openai_api_aqui"

# 6. Parâmetros e Ajustes Finos de RAG (Retrieval-Augmented Generation)
# Provedor e modelo preferencial de embeddings
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# Diretório local para salvamento temporário de PDFs de apoio
UPLOAD_DIR="./storage/uploads"

# Configuração de chunking consciente de tokens (Tiktoken + pgvector)
RAG_CHUNK_SIZE="500"
RAG_CHUNK_OVERLAP="80"

# Quantidade (Top-K) de trechos semelhantes extraídos para injetar no prompt do LLM
RAG_RETRIEVAL_LIMIT="5"
