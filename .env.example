# =========================================================================
# APP
# =========================================================================

DATABASE_URL="postgresql://admin:password123@localhost:5432/lumina_lms?schema=public"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TEACHER_REGISTRATION_KEY=""

# =========================================================================
# BANCO DE DADOS - DOCKER
# =========================================================================

DB_USER="admin"
DB_PASSWORD="password123"
DB_NAME="lumina_lms"

# =========================================================================
# REDIS - BULLMQ
# =========================================================================

REDIS_URL="redis://localhost:6379"

# =========================================================================
# IA - GOOGLE GEMINI
# Uso:
# - geração principal de conteúdo com RAG
# - geração principal de questões
# =========================================================================

GEMINI_API_KEY=""

CONTENT_GENERATION_PROVIDER="gemini"
CONTENT_GENERATION_MODEL="gemini-3.5-flash"

QUESTION_GENERATION_PROVIDER="gemini"
QUESTION_GENERATION_MODEL="gemini-3.5-flash"

# https://aistudio.google.com/projects

# =========================================================================
# IA - EXPLICAÇÃO PEDAGÓGICA
# Uso:
# - geração rápida de explicações após o aluno responder
# - Groq é o provedor principal deste pipeline
# =========================================================================

EXPLANATION_PROVIDER="groq"
EXPLANATION_MODEL="llama-3.1-8b-instant"
EXPLANATION_TEMPERATURE="0.3"
EXPLANATION_MAX_TOKENS="512"

# =========================================================================
# IA - FALLBACK DE CONTEÚDO
# Uso:
# - acionado quando o Gemini falhar na geração de conteúdo ou questões
# =========================================================================

GROQ_API_KEY=""

CONTENT_FALLBACK_ENABLED="true"
CONTENT_FALLBACK_PROVIDER="groq"
CONTENT_FALLBACK_MODEL="llama-3.3-70b-versatile"

# https://console.groq.com/keys

# =========================================================================
# EMBEDDINGS - RAG
# =========================================================================

EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_API_KEY=""

# https://platform.openai.com/usage

# =========================================================================
# RERANK - RAG
# =========================================================================

RAG_RERANK_ENABLED="true"
RAG_RERANK_PROVIDER="cohere"
RAG_RERANK_MODEL="rerank-v3.5"
COHERE_API_KEY=""

# https://dashboard.cohere.com/api-keys

# =========================================================================
# RAG - UPLOADS, CHUNKS E RECUPERAÇÃO
# =========================================================================

UPLOAD_DIR="./storage/uploads"

RAG_CHUNK_SIZE="1200" # Define o tamanho máximo (aproximado) de cada trecho criado a partir do documento pdf.
RAG_CHUNK_OVERLAP="200" # Define quantos caracteres do final de um chunk são repetidos no início do próximo.
#Chunk 1: caracteres 0–1199
#Chunk 2: caracteres 1000–2199
#Chunk 3: caracteres 2000–3199
RAG_RETRIEVAL_LIMIT="10" # Define quantos chunks candidatos são recuperados inicialmente pela busca vetorial. 
RAG_FINAL_CONTEXT_LIMIT="8" # Define quantos chunks, entre os candidatos recuperados, serão realmente enviados para a LLM.
# Alterar chunk size ou overlap afeta apenas novos arquivos enviados.

